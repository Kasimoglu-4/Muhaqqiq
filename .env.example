# Muhaqqiq production / local env (copy to .env — never commit secrets)

# Matching
MUHAQQIQ_DB=data/build/muhaqqiq.db
MUHAQQIQ_EMBEDDINGS=0
# MUHAQQIQ_EMBED_INDEX=data/build/embeddings.npz
# DATABASE_URL=postgresql://muhaqqiq:muhaqqiq@127.0.0.1:55432/muhaqqiq

# Production CORS (comma-separated origins for the Next.js host)
# MUHAQQIQ_CORS_ORIGINS=https://muhaqqiq.pages.dev,https://www.example.com

# OCR — editable confirm only; never auto-verify
# Local OCR: on Windows, tesseract mode prefers Windows.Media.Ocr when winocr is installed
# (much better on calligraphy posters). Fallback: system Tesseract + ara.traineddata.
# CI default: stub
MUHAQQIQ_OCR=tesseract
MUHAQQIQ_OCR_DAILY_CAP=500
# Optional: MUHAQQIQ_OCR=windows  |  tesseract-only still used if winocr missing
# Windows tessdata (prefer tessdata_best); quote paths; forward slashes
# MUHAQQIQ_TESSDATA="C:/Users/YOU/AppData/Local/tesseract-tessdata-best"
# TESSERACT_CMD="C:/Program Files/Tesseract-OCR/tesseract.exe"
# Production: MUHAQQIQ_OCR=azure  (or auto)
# AZURE_VISION_ENDPOINT=https://YOUR_RESOURCE.cognitiveservices.azure.com
# AZURE_VISION_KEY=

# Abuse controls (required in production)
# TURNSTILE_SECRET=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Ops
# SENTRY_DSN=
